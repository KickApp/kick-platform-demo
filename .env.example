# Kick Platform API organization access token (starts with `kick_org_`).
# In Cursor Cloud Agent environments this is injected as a secret env var, so
# no .env file is needed there. For local runs, copy this file to `.env`.
KICK_PLATFORM_API_TOKEN=kick_org_xxxxxxxxxxxxxxxx

# Base URL of the Kick API. Note the `/api` suffix: the Kick backend serves all
# routes under an `api` global prefix, so Platform endpoints live at
# `<base>/platform/v1/...`.
KICK_API_BASE_URL=https://use-dev.kick.co/api

# Port for the demo BFF backend (frontend dev server proxies /api to it).
BACKEND_PORT=4001

# Signing secret (`whsec_...`) of the webhook endpoint you registered in the Kick
# app under Organization -> API -> Webhooks -> Open portal. Optional: without it
# incoming webhooks are still logged, just without verifying their signature.
KICK_WEBHOOK_SIGNING_SECRET=

# Plaid API credentials for the Plaid Link flow, from your own Plaid dashboard.
# Optional: without them the app runs normally and only "New connection" is
# disabled. They stay server-side — the browser only ever sees a link token.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid environment to talk to: `sandbox` or `production`.
PLAID_ENV=sandbox

# Products to enable on the linked Item. Kick reads the connection with
# /processor/transactions/sync and /processor/auth/get, so it needs both.
PLAID_PRODUCTS=transactions,auth
