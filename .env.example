# Kick Platform API organization access token (starts with `kick_org_`).
# In Cursor Cloud Agent environments this is injected as a secret env var, so
# no .env file is needed there. For local runs, copy this file to `.env`.
KICK_PLATFORM_API_TOKEN=kick_org_xxxxxxxxxxxxxxxx

# Base URL of the Kick API. Note the `/api` suffix: the Kick backend serves all
# routes under an `api` global prefix, so Platform endpoints live at
# `<base>/platform/v1/...`.
KICK_API_BASE_URL=https://use-dev.kick.co/api

# Port for the demo BFF backend (frontend dev server proxies /api to it).
BACKEND_PORT=4001
